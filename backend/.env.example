# Runtime
NODE_ENV=development
PORT=8080

# Public hosts Twilio will use (ngrok, Cloudflare Tunnel, or your domain)
PUBLIC_WS_URL=wss://your-tunnel.example.com
PUBLIC_HTTP_URL=https://your-tunnel.example.com

# Protect REST /v1 and the command-center socket in production
BCC_API_KEY=change-me
COMMAND_CENTER_TOKEN=change-me

# Speech and language
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Live-agent fallback. Set a SIP URI or a PSTN number.
TRANSFER_SIP_URI=
TRANSFER_NUMBER=

# Where completed intake tickets are posted (optional)
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# Campaign routing. Numbers also live in config/number-map.json
DEFAULT_CAMPAIGN=generic-inbound
CAMPAIGN_NUMBERS=+15551230001:auto-insurance,+15551230002:medical-billing
